{
  "id": "chestny-znak",
  "name": "Chestny ZNAK",
  "family": "government",
  "version": "1.0.0",
  "sdk_version": 1,
  "capabilities": [
    "marking.status.read",
    "government.references.read",
    "government.reconciliation.run"
  ],
  "auth": [
    {
      "kind": "certificate",
      "secret_class": "government.certificate",
      "required": true
    }
  ],
  "rate_limit": {
    "max_concurrency": 2,
    "min_interval_ms": 200,
    "request_timeout_ms": 30000,
    "retry": {
      "max_attempts": 4,
      "base_backoff_ms": 500,
      "max_backoff_ms": 30000
    }
  }
}
