{
  "id": "lamoda",
  "name": "Lamoda",
  "family": "marketplace",
  "version": "1.0.0",
  "sdk_version": 1,
  "capabilities": ["inventory.read", "orders.read", "prices.read", "products.read"],
  "auth": [{"kind": "api_key", "secret_class": "marketplace.api-key", "required": true}],
  "rate_limit": {
    "max_concurrency": 2,
    "min_interval_ms": 300,
    "request_timeout_ms": 15000,
    "retry": {"max_attempts": 4, "base_backoff_ms": 500, "max_backoff_ms": 30000}
  }
}
