{
  "id": "aliexpress-ru",
  "name": "AliExpress RU",
  "family": "marketplace",
  "version": "1.0.0",
  "sdk_version": 1,
  "capabilities": ["products.read"],
  "auth": [{"kind": "api_key", "secret_class": "marketplace.jwt-token", "required": true}],
  "connection_test": {"url": "https://openapi.aliexpress.ru/api/v1/scroll-short-product-by-filter", "method": "POST", "headers": {"X-Auth-Token": "${secret}", "Content-Type": "application/json"}, "body": "{\"filter\":{},\"limit\":\"1\"}"},
  "rate_limit": {"max_concurrency": 4, "min_interval_ms": 100, "request_timeout_ms": 15000, "retry": {"max_attempts": 5, "base_backoff_ms": 500, "max_backoff_ms": 30000}}
}
