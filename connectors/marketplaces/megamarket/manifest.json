{
  "id": "megamarket",
  "name": "Megamarket",
  "family": "marketplace",
  "version": "1.0.0",
  "sdk_version": 1,
  "capabilities": ["inventory.read", "orders.read", "products.read"],
  "auth": [{"kind": "api_key", "secret_class": "marketplace.api-key", "required": true}],
  "connection_test": {"url": "https://api.megamarket.tech/api/merchantIntegration/assortment/v1/card/getAttributes", "method": "POST", "headers": {"X-Token": "${secret}", "Content-Type": "application/json"}, "body": "{\"filter\":{},\"sorting\":{\"field\":\"offerId\",\"order\":\"asc\"},\"limit\":1}"},
  "rate_limit": {"max_concurrency": 2, "min_interval_ms": 300, "request_timeout_ms": 15000, "retry": {"max_attempts": 5, "base_backoff_ms": 500, "max_backoff_ms": 30000}}
}
