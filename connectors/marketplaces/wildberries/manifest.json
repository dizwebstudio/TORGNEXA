{
  "id": "wildberries",
  "name": "Wildberries",
  "family": "marketplace",
  "version": "1.0.0",
  "sdk_version": 1,
  "capabilities": ["ads.read", "inventory.read", "products.read", "products.write"],
  "auth": [{"kind": "bearer", "secret_class": "marketplace.token", "required": true}],
  "connection_test": {"url": "https://marketplace-api.wildberries.ru/ping", "method": "GET", "headers": {"Authorization": "${secret}"}},
  "rate_limit": {
    "max_concurrency": 2,
    "min_interval_ms": 200,
    "request_timeout_ms": 15000,
    "retry": {"max_attempts": 5, "base_backoff_ms": 500, "max_backoff_ms": 30000}
  }
}
