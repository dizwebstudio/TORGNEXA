{
  "id": "vetis-mercury",
  "name": "VetIS Mercury",
  "family": "government",
  "version": "1.0.0",
  "sdk_version": 1,
  "capabilities": [
    "vetis.documents.read",
    "vetis.documents.write",
    "government.inventory.read",
    "government.reconciliation.run"
  ],
  "auth": [
    {
      "kind": "api_key",
      "secret_class": "government.credential",
      "required": true
    }
  ],
  "rate_limit": {
    "max_concurrency": 2,
    "min_interval_ms": 200,
    "request_timeout_ms": 30000,
    "retry": {
      "max_attempts": 4,
      "base_backoff_ms": 500,
      "max_backoff_ms": 30000
    }
  }
}
