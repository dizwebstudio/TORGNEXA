{
  "id": "saby-edo",
  "name": "Saby EDO",
  "family": "edo",
  "version": "1.0.0",
  "sdk_version": 1,
  "capabilities": [
    "edo.documents.read",
    "edo.documents.send",
    "edo.documents.sign_request"
  ],
  "auth": [
    {
      "kind": "bearer",
      "secret_class": "edo.credential",
      "required": true
    }
  ],
  "rate_limit": {
    "max_concurrency": 2,
    "min_interval_ms": 200,
    "request_timeout_ms": 30000,
    "retry": {
      "max_attempts": 4,
      "base_backoff_ms": 500,
      "max_backoff_ms": 30000
    }
  }
}
