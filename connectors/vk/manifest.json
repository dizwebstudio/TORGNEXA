{
  "id": "vk",
  "name": "VK",
  "family": "social",
  "version": "1.0.0",
  "sdk_version": 1,
  "capabilities": ["social.analytics.read", "social.comments.read", "social.comments.reply", "social.post.media", "social.post.text"],
  "auth": [{"kind": "oauth2", "secret_class": "social.user-oauth", "required": true, "oauth2": {"grant_type": "authorization_code", "authorization_url": "https://id.vk.com/authorize", "token_url": "https://id.vk.com/oauth2/auth", "scopes": ["groups", "wall", "photos", "video"], "client_auth_method": "client_secret_post"}}],
  "connection_test": {"url": "https://api.vk.com/method/account.getProfileInfo?v=5.199", "method": "GET", "headers": {"Authorization": "Bearer ${access_token}"}},
  "rate_limit": {"max_concurrency": 1, "min_interval_ms": 350, "request_timeout_ms": 15000, "retry": {"max_attempts": 5, "base_backoff_ms": 500, "max_backoff_ms": 30000}}
}
