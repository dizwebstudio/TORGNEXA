{
  "id": "ozon-delivery",
  "name": "Ozon Доставка",
  "family": "logistics",
  "version": "1.0.0",
  "sdk_version": 1,
  "capabilities": [
    "logistics.label.read",
    "logistics.rates.read",
    "logistics.shipment.create",
    "logistics.shipment.cancel",
    "logistics.track.read",
    "pickup.points.read"
  ],
  "auth": [
    {
      "kind": "api_key",
      "secret_class": "logistics.api-credentials",
      "required": true
    }
  ],
  "connection_test": {
    "url": "https://api-seller.ozon.ru/v2/warehouse/list",
    "method": "POST",
    "headers": {
      "Client-Id": "${client_id}",
      "Api-Key": "${api_key}",
      "Content-Type": "application/json"
    },
    "body": "{\"limit\":1}"
  },
  "rate_limit": {
    "max_concurrency": 2,
    "min_interval_ms": 250,
    "request_timeout_ms": 15000,
    "retry": {
      "max_attempts": 5,
      "base_backoff_ms": 500,
      "max_backoff_ms": 30000
    }
  }
}
