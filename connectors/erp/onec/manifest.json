{
  "id": "onec",
  "name": "1C",
  "family": "erp",
  "version": "1.0.0",
  "sdk_version": 1,
  "capabilities": ["erp.catalog.read", "erp.inventory.read"],
  "auth": [{"kind": "basic", "secret_class": "erp.basic-credentials", "required": true}],
  "rate_limit": {
    "max_concurrency": 2,
    "min_interval_ms": 100,
    "request_timeout_ms": 20000,
    "retry": {"max_attempts": 5, "base_backoff_ms": 500, "max_backoff_ms": 30000}
  }
}
