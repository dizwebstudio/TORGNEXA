{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/frontend/ui-session-v1.json",
  "title": "TORGNEXA frontend public session projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "display_name", "capabilities"],
  "properties": {
    "subject": {"type": "string", "minLength": 1, "maxLength": 256},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 200},
    "capabilities": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{1,127}$"}
    },
    "expires_at": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
