{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/security/security-event.json",
  "title": "SecurityEvent",
  "type": "object",
  "required": [
    "event_id",
    "occurred_at",
    "organization_id",
    "action",
    "outcome",
    "risk_class"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "organization_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "actor_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "actor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "action": {
      "type": "string"
    },
    "resource_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "resource_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "enum": [
        "success",
        "failure",
        "denied",
        "error"
      ]
    },
    "risk_class": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "source_ip": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
