{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/fx/rate-fact-v1.json",
  "title": "TORGNEXA Immutable FX Rate Fact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "base_currency",
    "quote_currency",
    "rate",
    "source",
    "rate_type",
    "observed_at",
    "effective_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "base_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "quote_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "rate": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]{1,9})?|0\\.[0-9]{0,8}[1-9])$"
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "source_reference": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "rate_type": {
      "enum": [
        "official",
        "mid",
        "bid",
        "ask",
        "closing",
        "indicative"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "$comment": "The Go domain constructor additionally enforces base_currency != quote_currency. The rate is an exact positive decimal string and never a JSON number. A new observation receives a new immutable fact id."
}
