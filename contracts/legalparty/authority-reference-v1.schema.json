{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/legalparty/authority-reference-v1.json",
  "title": "TORGNEXA Authority Reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "organization_id",
    "workspace_id",
    "counterparty_id",
    "authority_type",
    "reference_number",
    "issued_at",
    "status",
    "version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|[0-7][0-9A-HJKMNP-TV-Z]{25})$"
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "archived"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "counterparty_id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|[0-7][0-9A-HJKMNP-TV-Z]{25})$"
    },
    "authority_type": {
      "enum": [
        "charter",
        "power_of_attorney",
        "mchd",
        "order",
        "other"
      ]
    },
    "reference_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issuer": {
      "type": "string",
      "maxLength": 300
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
