{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/legalparty/branch-v1.json",
  "title": "TORGNEXA Branch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "organization_id",
    "workspace_id",
    "legal_entity_id",
    "code",
    "name",
    "country_code",
    "kpp",
    "status",
    "version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|[0-7][0-9A-HJKMNP-TV-Z]{25})$"
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "archived"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "legal_entity_id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|[0-7][0-9A-HJKMNP-TV-Z]{25})$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "kpp": {
      "type": "string",
      "maxLength": 16
    }
  }
}
