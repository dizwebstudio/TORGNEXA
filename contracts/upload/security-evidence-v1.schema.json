{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/upload/security-evidence-v1.json",
  "title": "TORGNEXA Upload Security Evidence v1",
  "type": "object",
  "required": ["id", "upload_id", "attempt", "policy_version", "content_sha256", "content_size_bytes", "detected_media_type", "extension", "decision", "reason_code", "checks", "scanner", "created_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^uev_[0-9a-f]{32}$"},
    "upload_id": {"type": "string", "pattern": "^upl_[0-9a-f]{32}$"},
    "attempt": {"type": "integer", "minimum": 1},
    "policy_version": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_size_bytes": {"type": "integer", "minimum": 0, "maximum": 10737418240},
    "detected_media_type": {"type": "string", "minLength": 3, "maxLength": 255},
    "extension": {"type": "string", "pattern": "^(none|\\.[a-z0-9]{1,15})$"},
    "decision": {"type": "string", "enum": ["clean", "rejected", "error"]},
    "reason_code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["code", "outcome"],
        "properties": {
          "code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "outcome": {"type": "string", "enum": ["pass", "fail"]}
        },
        "additionalProperties": false
      }
    },
    "scanner": {
      "type": "object",
      "required": ["scanner_name", "engine_version", "signature_version", "status"],
      "properties": {
        "scanner_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "engine_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "signature_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "status": {"type": "string", "enum": ["clean", "infected", "error", "not_run"]},
        "threat_code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}
      },
      "additionalProperties": false
    },
    "rescan_of": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "clean"}}},
      "then": {"properties": {"scanner": {"properties": {"status": {"const": "clean"}}}}}
    },
    {
      "if": {"properties": {"decision": {"const": "error"}}},
      "then": {"properties": {"scanner": {"properties": {"status": {"const": "error"}}}}}
    }
  ],
  "additionalProperties": false
}
