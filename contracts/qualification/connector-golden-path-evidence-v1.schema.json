{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/qualification/connector-golden-path-evidence-v1.json",
  "title": "TORGNEXA connector golden path evidence v1",
  "description": "Redacted credentialed non-production evidence for one carrier, payment or fiscal connector.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "scope",
    "environment",
    "target",
    "repository",
    "release_commit",
    "connector_id",
    "account_ref",
    "qualified_at",
    "checks",
    "rollback"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "PASS"},
    "scope": {"const": "connector"},
    "environment": {"const": "non-production"},
    "target": {"const": "dedicated-non-production"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,139}$"},
    "release_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "connector_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "account_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"},
    "qualified_at": {"type": "string", "format": "date-time"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence_ref"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
          "status": {"const": "PASS"},
          "evidence_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"}
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "evidence_ref"],
      "properties": {
        "verified": {"const": true},
        "evidence_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"}
      }
    }
  }
}
