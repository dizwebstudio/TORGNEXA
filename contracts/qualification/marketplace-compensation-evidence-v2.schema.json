{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/qualification/marketplace-compensation-evidence-v2.json",
  "title": "TORGNEXA marketplace compensation evidence v2",
  "description": "Redacted credentialed non-production evidence that a marketplace return, refund, compensation and settlement observation used one linked golden path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "scope", "environment", "target", "repository", "release_commit", "connector_id", "account_ref", "qualified_at", "flow", "checks", "observations", "rollback"],
  "properties": {
    "schema_version": {"const": 2},
    "status": {"const": "PASS"},
    "scope": {"const": "qualification"},
    "environment": {"const": "non-production"},
    "target": {"const": "dedicated-non-production"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,139}$"},
    "release_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "connector_id": {"enum": ["wildberries", "ozon", "yandex-market"]},
    "account_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"},
    "qualified_at": {"type": "string", "format": "date-time"},
    "flow": {"$ref": "#/$defs/flow"},
    "checks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence_ref"],
        "properties": {
          "id": {"enum": ["health", "return_authorize", "return_receive", "compensation", "compensation_read_after_write", "reconciliation"]},
          "status": {"const": "PASS"},
          "evidence_ref": {"type": "string", "pattern": "^marketplace-compensation/[a-z_]+$"}
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["return_status", "refund_status", "compensation_status", "settlement_status", "read_after_write", "idempotent_replay", "reconciliation"],
      "properties": {
        "return_status": {"const": "received"},
        "refund_status": {"const": "accepted"},
        "compensation_status": {"const": "accepted"},
        "settlement_status": {"const": "matched"},
        "read_after_write": {"const": true},
        "idempotent_replay": {"const": true},
        "reconciliation": {"const": true}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "evidence_ref"],
      "properties": {
        "verified": {"const": true},
        "evidence_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"}
      }
    }
  },
  "$defs": {
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow_ref", "order_ref", "reservation_ref", "shipment_ref", "return_ref", "refund_ref", "settlement_ref", "marking_ref", "edo_ref"],
      "properties": {
        "flow_ref": {"$ref": "#/$defs/ref"},
        "order_ref": {"$ref": "#/$defs/ref"},
        "reservation_ref": {"$ref": "#/$defs/ref"},
        "shipment_ref": {"$ref": "#/$defs/ref"},
        "return_ref": {"$ref": "#/$defs/ref"},
        "refund_ref": {"$ref": "#/$defs/ref"},
        "settlement_ref": {"$ref": "#/$defs/ref"},
        "marking_ref": {"$ref": "#/$defs/ref"},
        "edo_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"}
  }
}
