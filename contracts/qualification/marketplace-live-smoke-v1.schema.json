{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/qualification/marketplace-live-smoke-v1.json",
  "title": "TORGNEXA marketplace credentialed live smoke evidence v1",
  "description": "Redacted evidence emitted by the bounded marketplace live smoke runner. Credentials, remote payloads and business identifiers are never part of this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "scope",
    "environment",
    "target",
    "repository",
    "release_commit",
    "connector_id",
    "account_ref",
    "qualified_at",
    "credential_mode",
    "taxonomy",
    "checks",
    "write"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["PASS", "FAIL"]},
    "scope": {"enum": ["read", "qualification"]},
    "environment": {"const": "non-production"},
    "target": {"const": "dedicated-non-production"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,139}$"},
    "release_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "connector_id": {"enum": ["wildberries", "ozon"]},
    "account_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"},
    "qualified_at": {"type": "string", "format": "date-time"},
    "credential_mode": {"const": "env_only_secret_accessor"},
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "fingerprint", "source"],
      "properties": {
        "status": {"enum": ["PASS", "NOT_RUN"]},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{0,64}$"},
        "source": {"type": "string", "maxLength": 192}
      }
    },
    "checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence_ref"],
        "properties": {
          "id": {
            "enum": [
              "health",
              "products_read",
              "inventory_locations_read",
              "inventory_read",
              "orders_read",
              "taxonomy_read",
              "inventory_write",
              "read_after_write",
              "cleanup"
            ]
          },
          "status": {"const": "PASS"},
          "evidence_ref": {"type": "string", "pattern": "^marketplace-live-smoke/[a-z_]+$"},
          "error_code": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,95}$"}
        }
      }
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "read_after_write", "restored"],
      "properties": {
        "attempted": {"type": "boolean"},
        "read_after_write": {"type": "boolean"},
        "restored": {"type": "boolean"}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "error_code"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
        "error_code": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,95}$"}
      }
    }
  }
}
