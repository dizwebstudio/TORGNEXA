{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/qualification/production-golden-path-v1.json",
  "title": "TORGNEXA full production golden path qualification v1",
  "description": "Redacted release evidence binding the provider-neutral synthetic path to credentialed non-production marketplace, carrier, payment and fiscal evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "scope",
    "environment",
    "target",
    "repository",
    "release_commit",
    "qualified_at",
    "connectors",
    "artifacts",
    "checks",
    "failure_matrix",
    "rollback"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "PASS"},
    "scope": {"const": "credentialed-full"},
    "environment": {"const": "non-production"},
    "target": {"const": "dedicated-non-production"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,139}$"},
    "release_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "qualified_at": {"type": "string", "format": "date-time"},
    "connectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marketplace", "carrier", "payment", "fiscal"],
      "properties": {
        "marketplace": {"$ref": "#/$defs/connector"},
        "carrier": {"$ref": "#/$defs/connector"},
        "payment": {"$ref": "#/$defs/connector"},
        "fiscal": {"$ref": "#/$defs/connector"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "evidence_ref", "sha256"],
        "properties": {
          "kind": {"enum": ["marketplace-remote", "marketplace-live-smoke", "carrier", "payment", "fiscal"]},
          "evidence_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "status", "evidence_ref"],
        "properties": {
          "id": {
            "enum": [
              "marketplace_live_smoke",
              "order_import",
              "reservation",
              "pick_pack",
              "label",
              "shipment_handoff",
              "return_inspection",
              "refund_settlement",
              "marking_edo",
              "settlement_reconciliation",
              "profitability",
              "reconciliation"
            ]
          },
          "owner": {"enum": ["marketplace", "platform", "carrier", "payment", "fiscal"]},
          "status": {"const": "PASS"},
          "evidence_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"}
        }
      }
    },
    "failure_matrix": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence_ref"],
        "properties": {
          "id": {
            "enum": [
              "duplicate_commands",
              "duplicate_webhooks",
              "out_of_order_events",
              "worker_crash_resume",
              "lease_loss",
              "timeout_after_remote_commit",
              "insufficient_stock",
              "expired_label",
              "over_refund",
              "cross_tenant_access",
              "approval_denial",
              "rate_limit"
            ]
          },
          "status": {"const": "PASS"},
          "evidence_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"}
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "evidence_ref"],
      "properties": {
        "verified": {"const": true},
        "evidence_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"}
      }
    }
  },
  "$defs": {
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector_id", "account_ref", "evidence_ref"],
      "properties": {
        "connector_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "account_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"},
        "evidence_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"}
      }
    }
  }
}
