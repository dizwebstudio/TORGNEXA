{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "$id": "https://torgnexa.local/schemas/compliance/evaluation-result-v1.json",
  "title": "Compliance Evaluation Result v1",
  "type": "object",
  "required": [
    "outcome",
    "reasons",
    "evaluated_at",
    "fingerprint_sha256"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "allow",
        "warn",
        "approval_required",
        "block"
      ]
    },
    "reasons": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "policy_id",
          "policy_version",
          "document_type"
        ],
        "properties": {
          "code": {
            "enum": [
              "missing_evidence",
              "expired_evidence",
              "unverified_evidence",
              "invalid_evidence"
            ]
          },
          "policy_id": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|[0-7][0-9A-HJKMNP-TV-Z]{25})$"
          },
          "policy_version": {
            "type": "integer",
            "minimum": 1
          },
          "document_type": {
            "enum": [
              "declaration",
              "certificate",
              "eac_evidence",
              "state_registration",
              "veterinary",
              "sanitary",
              "refusal_letter",
              "information_letter",
              "other"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|[0-7][0-9A-HJKMNP-TV-Z]{25})$"
            }
          }
        }
      }
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
