{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "$id": "https://torgnexa.local/schemas/compliance/verification-result-v1.json",
  "title": "Compliance Registry Verification Result v1",
  "type": "object",
  "required": [
    "status",
    "source",
    "verified_at"
  ],
  "properties": {
    "status": {
      "enum": [
        "valid",
        "suspended",
        "revoked",
        "expired",
        "verification_failed"
      ]
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:/-]{0,127}$"
    },
    "registry_reference": {
      "type": "string",
      "maxLength": 256
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  }
}
