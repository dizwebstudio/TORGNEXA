{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "$id": "https://torgnexa.local/schemas/compliance/document-v2.json",
  "title": "Product Compliance Document v2",
  "type": "object",
  "required": [
    "id",
    "organization_id",
    "workspace_id",
    "document_type",
    "number",
    "jurisdiction",
    "issuer",
    "registry_source",
    "status",
    "issued_at",
    "version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|[0-7][0-9A-HJKMNP-TV-Z]{25})$"
    },
    "organization_id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|[0-7][0-9A-HJKMNP-TV-Z]{25})$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|[0-7][0-9A-HJKMNP-TV-Z]{25})$"
    },
    "document_type": {
      "enum": [
        "declaration",
        "certificate",
        "eac_evidence",
        "state_registration",
        "veterinary",
        "sanitary",
        "refusal_letter",
        "information_letter",
        "other"
      ]
    },
    "number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "registry_source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:/-]{0,127}$"
    },
    "registry_reference": {
      "type": "string",
      "maxLength": 256
    },
    "status": {
      "enum": [
        "draft",
        "valid",
        "suspended",
        "revoked",
        "expired",
        "verification_failed"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "expires_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "holder_party_type": {
      "enum": [
        "",
        "legal_entity",
        "individual_entrepreneur",
        "branch",
        "counterparty"
      ]
    },
    "holder_party_id": {
      "type": "string",
      "maxLength": 128
    },
    "evidence_object_id": {
      "type": "string",
      "maxLength": 128
    },
    "verification_source": {
      "type": "string",
      "maxLength": 128
    },
    "verified_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  }
}
