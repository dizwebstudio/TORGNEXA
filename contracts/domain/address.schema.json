{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/domain/address.json",
  "title": "TORGNEXA Provider-neutral Address",
  "type": "object",
  "additionalProperties": false,
  "required": ["country", "lines"],
  "properties": {
    "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "region": {"type": "string", "maxLength": 160},
    "city": {"type": "string", "maxLength": 160},
    "postal_code": {"type": "string", "maxLength": 160},
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    }
  },
  "description": "Non-localized address components. Provider/country-specific formatting and validation are adapter responsibilities."
}
