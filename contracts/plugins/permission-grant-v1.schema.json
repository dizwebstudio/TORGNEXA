{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/plugins/permission-grant-v1.json",
  "title": "TORGNEXA isolated plugin permission grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["connector_id", "connector_version", "artifact_sha256", "capabilities", "granted_at"],
  "properties": {
    "connector_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "connector_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capabilities": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,95}$"}},
    "secret_classes": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"}},
    "network": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "port"],
        "properties": {
          "host": {"type": "string", "minLength": 3, "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])$"},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535}
        }
      }
    },
    "granted_at": {"type": "string", "format": "date-time", "pattern": "Z$"}
  },
  "description": "Least-privilege installation grant bound to one exact connector version and artifact digest. Runtime grants may never exceed the signed request."
}
