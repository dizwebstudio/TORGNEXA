{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/plugins/admission-plan-v1.json",
  "title": "TORGNEXA inert isolated plugin admission plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["boundary_version", "execution_mode", "connector_id", "connector_version", "artifact_sha256", "trust", "granted_permissions", "isolation_limits"],
  "properties": {
    "boundary_version": {"const": 1},
    "execution_mode": {"const": "isolated_process_v1"},
    "connector_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "connector_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trust": {"enum": ["official", "verified", "community", "private"]},
    "granted_permissions": {"$ref": "https://torgnexa.local/schemas/plugins/permission-grant-v1.json"},
    "isolation_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_mib", "cpu_time_ms", "wall_time_ms", "max_output_bytes", "max_concurrent_calls"],
      "properties": {
        "memory_mib": {"type": "integer", "minimum": 16, "maximum": 4096},
        "cpu_time_ms": {"type": "integer", "minimum": 100, "maximum": 300000},
        "wall_time_ms": {"type": "integer", "minimum": 100, "maximum": 300000},
        "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 16777216},
        "max_concurrent_calls": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    }
  },
  "description": "Inert result of Task-025 verification. It has no command, binary path, environment, filesystem or raw secret fields and is not executable by Task 025."
}
