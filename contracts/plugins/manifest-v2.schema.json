{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/plugins/manifest-v2.json",
  "title": "TORGNEXA Connector Manifest v2 / SDK v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "family",
    "version",
    "sdk_version",
    "capabilities",
    "auth",
    "rate_limit"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "family": {
      "enum": [
        "marketplace",
        "storefront",
        "classified",
        "social",
        "erp",
        "edo",
        "government",
        "payment",
        "logistics",
        "pickup",
        "fx",
        "notification",
        "crm"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sdk_version": {
      "const": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "products.read",
          "products.write",
          "prices.read",
          "prices.write",
          "inventory.read",
          "inventory.write",
          "orders.read",
          "notifications.receive",
          "orders.status.write",
          "returns.read",
          "reviews.read",
          "reviews.reply",
          "messages.read",
          "messages.reply",
          "ads.read",
          "ads.manage",
          "promotions.read",
          "promotions.manage",
          "finance.settlements.read",
          "social.post.text",
          "social.post.media",
          "social.post.video",
          "social.post.edit",
          "social.post.delete",
          "social.comments.read",
          "social.comments.reply",
          "social.analytics.read",
          "erp.catalog.read",
          "erp.catalog.write",
          "erp.inventory.read",
          "erp.orders.read",
          "erp.orders.write",
          "edo.documents.read",
          "edo.documents.send",
          "edo.documents.sign_request",
          "marking.status.read",
          "marking.documents.write",
          "fiscal.receipts.write",
          "vetis.documents.read",
          "vetis.documents.write",
          "payments.create",
          "payments.refund",
          "payments.reconcile",
          "logistics.rates.read",
            "logistics.batches.archive",
            "logistics.batches.archive.read",
            "logistics.batches.unarchive",
          "logistics.shipment.create",
          "logistics.track.read",
          "logistics.return.create",
          "logistics.return.separate.create",
          "logistics.return.separate.delete",
          "logistics.return.separate.edit",
          "pickup.points.read",
          "pickup.capacity.read",
          "pickup.orders.write",
          "compliance.documents.read",
          "compliance.documents.write",
          "compliance.evaluate",
          "government.identity.read",
          "government.documents.read",
          "government.documents.write",
          "government.inventory.read",
          "government.references.read",
          "government.reconciliation.run",
          "payments.status.read",
          "payments.webhooks",
          "logistics.shipment.cancel",
          "logistics.label.read",
          "fx.rates.read",
          "notifications.sms.send",
          "notifications.sms.status.read"
        ]
      }
    },
    "auth": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "required"
        ],
        "properties": {
          "kind": {
            "enum": [
              "none",
              "api_key",
              "bearer",
              "basic",
              "oauth2",
              "certificate"
            ]
          },
          "secret_class": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "required": {
            "type": "boolean"
          },
          "oauth2": {
            "type": "object",
            "additionalProperties": false,
            "required": ["grant_type", "token_url", "client_auth_method"],
            "properties": {
              "grant_type": {"enum": ["authorization_code", "client_credentials"]},
              "authorization_url": {"type": "string", "format": "uri", "pattern": "^https://"},
              "token_url": {"type": "string", "format": "uri", "pattern": "^https://"},
              "scopes": {
                "type": "array",
                "maxItems": 32,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\s]+$"}
              },
              "client_auth_method": {"const": "client_secret_post"}
            },
            "allOf": [{
              "if": {"properties": {"grant_type": {"const": "authorization_code"}}, "required": ["grant_type"]},
              "then": {"required": ["authorization_url"]},
              "else": {"not": {"required": ["authorization_url"]}}
            }]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "none"
                }
              }
            },
            "then": {
              "properties": {
                "required": {
                  "const": false
                }
              },
              "not": {
                "required": [
                  "secret_class"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "required": {
                  "const": true
                }
              }
            },
            "then": {
              "if": {
                "properties": {
                  "kind": {
                    "not": {
                      "const": "none"
                    }
                  }
                }
              },
              "then": {
                "required": [
                  "secret_class"
                ]
              }
            }
          },
          {
            "if": {"properties": {"kind": {"const": "oauth2"}}, "required": ["kind"]},
            "then": {"required": ["oauth2"]},
            "else": {"not": {"required": ["oauth2"]}}
          }
        ]
      }
    },
    "connection_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "method"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "method": {"enum": ["GET", "POST"]},
        "headers": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {"pattern": "^[A-Za-z0-9-]{1,128}$"},
          "additionalProperties": {"type": "string", "maxLength": 2048, "pattern": "^[^\\r\\n]*$"}
        },
        "body": {"type": "string", "maxLength": 16384},
        "success_statuses": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 200, "maximum": 299}
        }
      }
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_concurrency",
        "min_interval_ms",
        "request_timeout_ms",
        "retry"
      ],
      "properties": {
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "min_interval_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "request_timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_attempts",
            "base_backoff_ms",
            "max_backoff_ms"
          ],
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "base_backoff_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "max_backoff_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            }
          }
        }
      }
    }
  },
  "description": "Additive manifest contract for Connector SDK v1. Family/capability compatibility is additionally enforced by the executable SDK registry."
}
