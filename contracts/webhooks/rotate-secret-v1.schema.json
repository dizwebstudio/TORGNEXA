{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/webhooks/rotate-secret-v1.json",
  "title": "Rotate webhook signing secret",
  "type": "object",
  "additionalProperties": false,
  "required": ["signing_secret", "overlap_seconds"],
  "properties": {
    "signing_secret": {"type": "string", "minLength": 32, "maxLength": 64},
    "overlap_seconds": {"type": "integer", "minimum": 300, "maximum": 86400}
  }
}
