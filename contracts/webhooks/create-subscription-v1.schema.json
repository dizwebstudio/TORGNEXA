{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/webhooks/create-subscription-v1.json",
  "title": "Create webhook subscription",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "endpoint", "event_types", "signing_secret"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "endpoint": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https://[^?#]+$"},
    "event_types": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string"}},
    "signing_secret": {"type": "string", "minLength": 32, "maxLength": 64}
  }
}
