{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/webhooks/replay-response-v1.json",
  "title": "Webhook replay response",
  "type": "object",
  "additionalProperties": false,
  "required": ["delivery_id", "replay_of", "status"],
  "properties": {
    "delivery_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "replay_of": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {"const": "pending"}
  }
}
