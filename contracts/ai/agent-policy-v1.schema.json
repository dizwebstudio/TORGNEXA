{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/ai/agent-policy-v1.json",
  "title": "TORGNEXA AI agent policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "agent_id",
    "integration_id",
    "rules",
    "effective_from"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
    },
    "integration_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/toolRule"
      }
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "effective_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "minor_units"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "minor_units": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "money": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/money"
          }
        },
        "max_quantity": {
          "type": "integer",
          "minimum": 0
        },
        "max_percentage_basis_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "max_batch_size": {
          "type": "integer",
          "minimum": 0
        },
        "max_calls": {
          "type": "integer",
          "minimum": 0
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2678400
        }
      }
    },
    "toolRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "permission",
        "risk",
        "approval_required",
        "allow_untrusted_write",
        "limits"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
        },
        "permission": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
        },
        "risk": {
          "type": "string",
          "enum": [
            "read",
            "safe_write",
            "sensitive_write",
            "prohibited"
          ]
        },
        "approval_required": {
          "type": "boolean"
        },
        "allow_untrusted_write": {
          "type": "boolean"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      }
    }
  }
}
