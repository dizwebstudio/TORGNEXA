{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://torgnexa.local/schemas/pim/duplicate-candidate-v1.json",
  "title":"TORGNEXA PIM Duplicate Candidate v1",
  "type":"object","additionalProperties":false,
  "required":["id","organization_id","workspace_id","entity_type","left_id","right_id","score_bps","signals","state","version","created_at","updated_at"],
  "properties":{
    "id":{"type":"string","minLength":1,"maxLength":36},"organization_id":{"type":"string","minLength":1,"maxLength":36},"workspace_id":{"type":"string","minLength":1,"maxLength":36},
    "entity_type":{"enum":["brand","category","attribute"]},"left_id":{"type":"string","minLength":1,"maxLength":36},"right_id":{"type":"string","minLength":1,"maxLength":36},
    "score_bps":{"type":"integer","minimum":0,"maximum":10000},
    "signals":{"type":"array","minItems":1,"maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["kind","explanation","weight_bps"],"properties":{"kind":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,127}$"},"explanation":{"type":"string","minLength":1,"maxLength":300},"weight_bps":{"type":"integer","minimum":0,"maximum":10000}}}},
    "state":{"enum":["open","confirmed","not_duplicate","merged"]},"version":{"type":"integer","minimum":1},
    "created_at":{"type":"string","format":"date-time","pattern":"Z$"},"updated_at":{"type":"string","format":"date-time","pattern":"Z$"}
  }
}
