{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://torgnexa.local/schemas/pim/field-authority-v1.json",
  "title":"TORGNEXA PIM Field Authority v1",
  "type":"object","additionalProperties":false,
  "required":["id","organization_id","workspace_id","entity_type","field_path","source","priority","active","version","created_at","updated_at"],
  "properties":{
    "id":{"type":"string","minLength":1,"maxLength":36},"organization_id":{"type":"string","minLength":1,"maxLength":36},"workspace_id":{"type":"string","minLength":1,"maxLength":36},
    "entity_type":{"enum":["brand","category","attribute"]},"field_path":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,127}$"},"source":{"type":"string","pattern":"^[a-z][a-z0-9._:/-]{0,127}$"},
    "priority":{"type":"integer","minimum":0,"maximum":10000},"active":{"type":"boolean"},"version":{"type":"integer","minimum":1},
    "created_at":{"type":"string","format":"date-time","pattern":"Z$"},"updated_at":{"type":"string","format":"date-time","pattern":"Z$"}
  }
}
