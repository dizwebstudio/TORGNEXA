{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/secrets/secret-reference.json",
  "title": "TORGNEXA Secret Reference Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference",
    "organization_id",
    "workspace_id",
    "class",
    "status",
    "current_version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "reference": {
      "type": "string",
      "pattern": "^sec:v1:[0-9a-f]{32}$",
      "description": "Opaque non-secret handle. Credential material must never be embedded in the reference."
    },
    "organization_id": { "$ref": "#/$defs/sortable_id" },
    "workspace_id": { "$ref": "#/$defs/sortable_id" },
    "class": {
      "type": "string",
      "enum": [
        "connector_token",
        "oauth_client",
        "oauth_refresh",
        "erp_credential",
        "webhook_signing",
        "certificate",
        "storage_credential",
        "logistics_shipment"
      ]
    },
    "status": { "type": "string", "enum": ["active", "revoked"] },
    "current_version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "revoked_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "active" } } },
      "then": { "properties": { "revoked_at": { "type": "null" } } }
    },
    {
      "if": { "properties": { "status": { "const": "revoked" } } },
      "then": { "required": ["revoked_at"], "properties": { "revoked_at": { "type": "string", "format": "date-time" } } }
    }
  ],
  "$defs": {
    "sortable_id": {
      "type": "string",
      "anyOf": [
        { "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        { "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" }
      ]
    }
  }
}
