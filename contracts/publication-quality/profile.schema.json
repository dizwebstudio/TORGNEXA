{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/publication-quality/profile.json",
  "title": "TORGNEXA publication quality profile",
  "description": "Bounded declarative publication checks. Profiles cannot execute code, SQL, HTTP or regular expressions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "connector_id", "channel_family", "locale", "jurisdiction", "freshness_ttl_seconds", "rules", "weights", "required_media", "allowed_media_formats", "max_media_bytes", "require_price", "require_stock", "currency", "active"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"},
    "version": {"type": "integer", "minimum": 1},
    "connector_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"},
    "channel_family": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"},
    "locale": {"type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$"},
    "jurisdiction": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "freshness_ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 2592000},
    "rules": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/rule"}},
    "weights": {"type": "object", "propertyNames": {"enum": ["identity_content", "category_attributes", "media", "price_stock", "compliance", "mapping_capability", "localization", "channel_contract"]}, "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 10000}},
    "required_media": {"type": "integer", "minimum": 0, "maximum": 64},
    "allowed_media_formats": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"}},
    "max_media_bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824},
    "require_price": {"type": "boolean"},
    "require_stock": {"type": "boolean"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "active": {"type": "boolean"}
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "field", "kind", "severity", "message", "remediation"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
        "category": {"enum": ["identity_content", "category_attributes", "media", "price_stock", "compliance", "mapping_capability", "localization", "channel_contract"]},
        "field": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
        "kind": {"enum": ["required", "max_length", "enum", "min_value", "max_value"]},
        "severity": {"enum": ["block", "approval_required", "warn", "info"]},
        "max_length": {"type": "integer", "minimum": 1, "maximum": 20000},
        "allowed": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "string", "maxLength": 256}},
        "min": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$"},
        "max": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 240},
        "remediation": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    }
  }
}
