{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "governance.approval.decided.v1",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://torgnexa.local/schemas/events/approval-decided-v1.json",
  "required": [
    "request_id",
    "decision_id",
    "stage",
    "decision",
    "state",
    "version"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "stage": {
      "type": "integer",
      "minimum": 1
    },
    "decision": {
      "enum": [
        "approve",
        "reject"
      ]
    },
    "state": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 2
    }
  }
}
