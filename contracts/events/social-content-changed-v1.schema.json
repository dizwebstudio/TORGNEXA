{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/events/social-content-changed-v1.json",
  "title": "commerce.social.content_changed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_id",
    "status",
    "version",
    "change"
  ],
  "properties": {
    "content_id": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "archived"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "change": {
      "enum": [
        "created",
        "updated",
        "status_changed"
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|[0-7][0-9A-HJKMNP-TV-Z]{25})$"
    }
  }
}
