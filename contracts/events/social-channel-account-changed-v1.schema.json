{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/events/social-channel-account-changed-v1.json",
  "title": "commerce.social.channel_account_changed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "channel_account_id",
    "connector_account_id",
    "status",
    "capabilities",
    "version",
    "change"
  ],
  "properties": {
    "channel_account_id": {
      "$ref": "#/$defs/id"
    },
    "connector_account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "status": {
      "enum": [
        "disabled",
        "active"
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "social.analytics.read",
          "social.comments.read",
          "social.comments.reply",
          "social.post.delete",
          "social.post.edit",
          "social.post.buttons",
          "social.post.media",
          "social.post.text",
          "social.post.video",
          "social.webhooks"
        ]
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "change": {
      "enum": [
        "created",
        "updated"
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|[0-7][0-9A-HJKMNP-TV-Z]{25})$"
    }
  }
}
