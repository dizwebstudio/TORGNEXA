{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/events/warehouse-changed-v1.json",
  "title": "commerce.inventory.warehouse_changed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "warehouse_id",
    "status",
    "version",
    "change"
  ],
  "properties": {
    "warehouse_id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|[0-7][0-9A-HJKMNP-TV-Z]{25})$"
    },
    "status": {
      "enum": [
        "active",
        "disabled"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "change": {
      "enum": [
        "created",
        "status_changed"
      ]
    }
  }
}
