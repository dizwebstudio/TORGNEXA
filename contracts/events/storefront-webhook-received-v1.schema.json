{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/events/storefront-webhook-received-v1.json",
  "title": "commerce.storefront.webhook_received.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connector_account_id",
    "event_type",
    "resource_kind",
    "resource_remote_id",
    "canonical_payload"
  ],
  "properties": {
    "connector_account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "event_type": {
      "type": "string",
      "pattern": "^(order|product|coupon|customer)\\.(created|updated|deleted)$"
    },
    "resource_kind": {
      "type": "string",
      "enum": ["order", "product", "coupon", "customer"]
    },
    "resource_remote_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"
    },
    "canonical_payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
