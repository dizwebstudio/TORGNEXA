{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/events/catalog-bulk-preview-created-v1.json",
  "title": "commerce.catalog.bulk_preview_created.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["preview_id", "selection_digest", "input_digest", "channel_count", "sku_count", "row_count", "blocked_count", "created_at"],
  "properties": {
    "preview_id": {"type": "string", "maxLength": 192},
    "selection_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "channel_count": {"type": "integer", "minimum": 1, "maximum": 8},
    "sku_count": {"type": "integer", "minimum": 1, "maximum": 1000},
    "row_count": {"type": "integer", "minimum": 1, "maximum": 8000},
    "blocked_count": {"type": "integer", "minimum": 0, "maximum": 8000},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
