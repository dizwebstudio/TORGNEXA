{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/events/offer-changed-v1.json",
  "title": "commerce.catalog.offer_changed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["offer_id","product_id","version","status","change"],
  "properties": {
    "offer_id": {"type":"string","minLength":1,"maxLength":36},
    "product_id": {"type":"string","minLength":1,"maxLength":36},
    "version": {"type":"integer","minimum":1},
    "status": {"enum":["draft","active","archived"]},
    "change": {"enum":["created","updated","status_changed"]}
  }
}
