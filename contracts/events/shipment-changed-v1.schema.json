{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/events/shipment-changed-v1.json",
  "title": "commerce.fulfillment.shipment_changed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["shipment_id", "status", "version", "operation"],
  "properties": {
    "shipment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"},
    "status": {"enum": ["pending", "created", "in_transit", "delivered", "cancelled", "unknown"]},
    "version": {"type": "integer", "minimum": 1},
    "operation": {"enum": ["create_requested", "created", "cancel_requested", "cancelled", "cancel_unknown"]},
    "approval_request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"}
  }
}
