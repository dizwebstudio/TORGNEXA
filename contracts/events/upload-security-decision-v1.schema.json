{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/events/upload-security-decision-v1.json",
  "title": "security.upload.decision.v1",
  "type": "object",
  "required": ["event_id", "object_id", "evidence_id", "decision", "reason_code", "detected_media_type", "scanner_status"],
  "properties": {
    "event_id": {"type": "string"},
    "object_id": {"type": "string", "pattern": "^upl_[0-9a-f]{32}$"},
    "evidence_id": {"type": "string", "pattern": "^uev_[0-9a-f]{32}$"},
    "decision": {"type": "string", "enum": ["clean", "rejected", "error"]},
    "reason_code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "detected_media_type": {"type": "string", "minLength": 3, "maxLength": 255},
    "scanner_status": {"type": "string", "enum": ["clean", "infected", "error", "not_run"]}
  },
  "additionalProperties": false
}
