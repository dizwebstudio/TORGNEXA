{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torgnexa.local/schemas/workflow/run-v1.json",
  "title": "TORGNEXA workflow run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workflow_id", "workflow_version", "trigger_kind", "status", "attempt_count", "available_at", "version"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "workflow_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "workflow_version": {"type": "integer", "minimum": 1},
    "trigger_kind": {"enum": ["event", "schedule"]},
    "trigger_ref": {"type": "string", "maxLength": 256},
    "status": {"enum": ["queued", "running", "waiting_approval", "waiting_retry", "completed", "failed", "cancelled"]},
    "attempt_count": {"type": "integer", "minimum": 0, "maximum": 64},
    "available_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "last_error_code": {"type": "string", "maxLength": 64},
    "version": {"type": "integer", "minimum": 1}
  }
}
