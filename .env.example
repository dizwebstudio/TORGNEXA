# Шаблон переменных Community-развёртывания.
#
# Не копируйте этот файл в .env с пустыми секретами. Безопасный способ:
#   make community-init
#   make community-up
#
# Команда создаёт .env с правами 0600 и случайными секретами. Подробное
# описание, форматы и порядок ручной настройки:
# docs/deployment/environment-variables.md

# -----------------------------------------------------------------------------
# Версия приложения и журналирование
# -----------------------------------------------------------------------------

# Метка версии, попадающая в сборку и журнал миграций.
TORGNEXA_VERSION=0.1.0-dev
# Допустимо: debug, info, warn, error.
TORGNEXA_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Обязательные секреты. Оставлены пустыми намеренно; генерируются автоматически.
# Никогда не коммитьте заполненный .env.
# -----------------------------------------------------------------------------

# Base64 от 32 случайных байт: ключ шифрования секретов интеграций.
TORGNEXA_SECRETS_MASTER_KEY=
# Пароль владельца PostgreSQL для миграций и административных операций.
POSTGRES_PASSWORD=
# Отдельный пароль ограниченной прикладной роли PostgreSQL.
TORGNEXA_APP_DB_PASSWORD=
# Пароль отдельной базы/роли Keycloak.
KEYCLOAK_DB_PASSWORD=
# Локальный bootstrap-администратор Keycloak.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
# Внутренние ключи конфигурации и наблюдаемости Garage.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=
# Учётные данные S3-совместимого хранилища Garage.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Пароль аналитической базы ClickHouse.
CLICKHOUSE_USERNAME=torgnexa
CLICKHOUSE_PASSWORD=

# -----------------------------------------------------------------------------
# Хранилище и таймауты
# -----------------------------------------------------------------------------

# DNS-безопасное имя bucket: строчные буквы, цифры, точка и дефис.
S3_BUCKET=torgnexa
# Таймаут S3-запроса в Go duration, допустимо от 1s до 2m.
TORGNEXA_S3_REQUEST_TIMEOUT=30s
# Таймаут аналитического запроса, допустимо от 100ms до 30s.
TORGNEXA_CLICKHOUSE_QUERY_TIMEOUT=5s

# -----------------------------------------------------------------------------
# Порты на хосте. Все сервисы публикуются только на 127.0.0.1.
# Меняйте значение, если порт занят; диапазон 1–65535.
# -----------------------------------------------------------------------------

POSTGRES_PORT=5432
KAFKA_PORT=9092
# Канонические topics создаются одноразовым kafka-init при старте Compose.
# Для одновузлового Community оставьте 1; в HA production задайте параметры
# брокерного кворума (например, partitions=3 и replication_factor=3).
TORGNEXA_KAFKA_TOPIC_PARTITIONS=1
TORGNEXA_KAFKA_TOPIC_REPLICATION_FACTOR=1
VALKEY_PORT=6379
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
S3_PORT=9002
KEYCLOAK_PORT=8081
TORGNEXA_API_PORT=8080
TORGNEXA_MCP_PORT=8090
TORGNEXA_FRONTEND_PORT=5173

# MTU внутренней bridge-сети Docker. Значение должно быть не больше MTU
# фактического egress-интерфейса/VPN; 1376 безопасно для стандартного Community
# профиля и предотвращает зависание крупных TLS handshake из контейнеров.
TORGNEXA_DOCKER_NETWORK_MTU=1376

# -----------------------------------------------------------------------------
# PostgreSQL. Для локального запуска обычно оставьте значения по умолчанию.
# -----------------------------------------------------------------------------

TORGNEXA_DB_MAX_OPEN_CONNS=20
TORGNEXA_DB_MAX_IDLE_CONNS=10
TORGNEXA_DB_CONN_MAX_LIFETIME=30m
TORGNEXA_DB_CONN_MAX_IDLE_TIME=5m
TORGNEXA_DB_CONNECT_TIMEOUT=5s

# -----------------------------------------------------------------------------
# Вход и управляемые OIDC-провайдеры
# -----------------------------------------------------------------------------

# CSV-список разрешённых host без схемы и пути, например:
# login.company.ru,id.company.ru
# Пустое значение запрещает добавление внешних issuer (default deny).
TORGNEXA_OIDC_MANAGED_ISSUER_HOSTS=

# -----------------------------------------------------------------------------
# Фоновый worker
# -----------------------------------------------------------------------------

# Идентификатор Kafka consumer group. Для одного логического worker-кластера
# экземпляры должны использовать одно значение.
TORGNEXA_KAFKA_CONSUMER_GROUP=torgnexa.webhooks.v1
# Интервал опроса 50ms–30s, размер пачки 1–1000, lease 10s–10m.
TORGNEXA_WORKER_POLL_INTERVAL=500ms
TORGNEXA_WORKER_DISPATCH_BATCH=32
TORGNEXA_WORKER_LEASE=90s
# Включает периодическую сверку внешних и внутренних данных.
TORGNEXA_WORKER_RECONCILIATION_ENABLED=true
# Проверка загрузок выключена, пока в backend-сети не доступен ClamAV.
TORGNEXA_WORKER_UPLOADS_ENABLED=true
TORGNEXA_CLAMAV_NETWORK=tcp
TORGNEXA_CLAMAV_ADDRESS=clamav:3310
TORGNEXA_CLAMAV_ENGINE_VERSION=runtime
TORGNEXA_CLAMAV_SIGNATURE_VERSION=runtime
TORGNEXA_CLAMAV_TIMEOUT=30s

# Эти параметры нужны только при прямом запуске worker вне Community Compose:
# Compose всегда использует внутренний адрес kafka:29092 и встроенный список тем.
# TORGNEXA_KAFKA_BROKERS=127.0.0.1:9092
# Include the commerce topics when running the worker directly; prices and
# inventory are consumed by the dedicated commerce-sync route.
# TORGNEXA_KAFKA_TOPICS=commerce.catalog.events.v1,commerce.inventory.events.v1,commerce.orders.events.v1,commerce.pricing.events.v1

# -----------------------------------------------------------------------------
# Необязательные внешние каналы уведомлений.
# Пустые значения означают, что соответствующий транспорт не настроен.
# -----------------------------------------------------------------------------

NOTIFICATION_SMTP_ADDRESS=
NOTIFICATION_SMTP_FROM=
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_SMTP_SERVER_NAME=
NOTIFICATION_SMTP_IMPLICIT_TLS=false
NOTIFICATION_CHAT_ENDPOINT=
NOTIFICATION_DELIVERY_TIMEOUT=10s
