{
  "name": "n8n-nodes-torgnexa",
  "version": "0.1.0",
  "description": "Official TORGNEXA community node for public REST resources and signed webhook triggers.",
  "license": "MIT",
  "keywords": [
    "n8n-community-node-package",
    "torgnexa",
    "commerce",
    "marketplace",
    "automation"
  ],
  "author": {
    "name": "TORGNEXA"
  },
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "clean": "node ./scripts/clean-build.mjs",
    "build": "npm run clean && tsc -p tsconfig.release.json && node ./scripts/copy-assets.mjs",
    "build:watch": "tsc -p tsconfig.release.json --watch",
    "lint": "tsc -p tsconfig.release.json --noEmit",
    "test:offline": "tsc -p tsconfig.offline.json && node --test test/*.test.cjs",
    "verify:package": "node ./scripts/verify-package.mjs",
    "prepublishOnly": "npm run build && npm run test:offline && npm run verify:package"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/TorgnexaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Torgnexa/Torgnexa.node.js",
      "dist/nodes/TorgnexaTrigger/TorgnexaTrigger.node.js"
    ]
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "2.16.0"
  },
  "packageManager": "npm@10.9.2",
  "peerDependenciesMeta": {
    "n8n-workflow": {
      "optional": true
    }
  }
}
