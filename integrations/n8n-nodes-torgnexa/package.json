{
  "name": "n8n-nodes-torgnexa",
  "version": "0.2.0",
  "description": "Official TORGNEXA community node for catalog, orders, inventory, fulfillment, synchronization, pricing and signed webhook triggers.",
  "license": "MIT",
  "keywords": [
    "n8n-community-node-package",
    "torgnexa",
    "commerce",
    "marketplace",
    "automation"
  ],
  "author": {
    "name": "TORGNEXA"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/torgnexa/torgnexa.git",
    "directory": "integrations/n8n-nodes-torgnexa"
  },
  "homepage": "https://docs.torgnexa.local/developer/n8n",
  "bugs": {
    "url": "https://github.com/torgnexa/torgnexa/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "clean": "node ./scripts/clean-build.mjs",
    "build": "npm run clean && tsc -p tsconfig.release.json && node ./scripts/copy-assets.mjs",
    "build:watch": "tsc -p tsconfig.release.json --watch",
    "lint": "tsc -p tsconfig.release.json --noEmit",
    "test:offline": "tsc -p tsconfig.offline.json && node --test test/core.test.cjs",
    "test:e2e": "node ./test/e2e-installation.test.cjs",
    "pack:verify": "npm pack --dry-run",
    "verify:package": "node ./scripts/verify-package.mjs",
    "prepublishOnly": "npm run build && npm run test:offline && npm run test:e2e && npm run verify:package"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "COMPATIBILITY.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/TorgnexaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Torgnexa/Torgnexa.node.js",
      "dist/nodes/TorgnexaTrigger/TorgnexaTrigger.node.js"
    ]
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "2.16.0"
  },
  "packageManager": "npm@10.9.2",
  "peerDependenciesMeta": {
    "n8n-workflow": {
      "optional": true
    }
  }
}
