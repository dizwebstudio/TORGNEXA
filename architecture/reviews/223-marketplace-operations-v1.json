  "gap_audit": {
    "performed": true,
    "prompt": "prompts/05-architecture-gap-audit.txt",
    "decision": "architecture_change"
  },
  "impacts": [
    {"area":"tenancy", "status":"affected", "evidence":"Account, capability, operation, checkpoint and reconciliation state must use authenticated organization/workspace scope and forced RLS."},
    {"area":"privacy_data_governance", "status":"affected", "evidence":"The integration gate retains only bounded references, statuses, hashes and quality evidence; credentials, raw provider payloads and unnecessary PII remain excluded."},
    {"area":"api_compatibility", "status":"affected", "evidence":"Future child-slice routes are additive OpenAPI contracts with generated SDK parity; this parent ADR does not alter existing routes."},
    {"area":"event_compatibility", "status":"affected", "evidence":"Cross-domain orchestration must use canonical envelope, Transactional Outbox and Inbox/deduplication; no unversioned event is admitted."},
    {"area":"plugin_sdk_compatibility", "status":"affected", "evidence":"Provider differences remain typed connector capabilities and runtime support states; Core does not branch on provider names."},
    {"area":"database_migration", "status":"affected", "evidence":"The parent gate has no standalone migration; child slices retain expand-only, backup-gated and forced-RLS migration ownership."},
    {"area":"security", "status":"affected", "evidence":"Default-deny capabilities, scoped SecretProvider access, approval/policy checks and fail-closed unknown outcomes apply to marketplace writes."},
    {"area":"approvals_risk", "status":"affected", "evidence":"Write-sensitive catalog, price, order, shipment, marking, advertising and finance actions require risk-aware approval and idempotency."},
    {"area":"audit_lineage", "status":"affected", "evidence":"Operation references, source refs, approvals, versions, checkpoints and reconciliation findings provide append-only lineage across domains."},
    {"area":"reconciliation_idempotency", "status":"affected", "evidence":"The full gate explicitly tests duplicate commands/events/webhooks, stale updates, replay, partial results and remote unknown outcomes."},
    {"area":"webhooks_egress", "status":"affected", "evidence":"Provider calls remain fixed connector transports with timeout, rate-limit and normalized error boundaries; caller-controlled hosts are not admitted."},
    {"area":"slo_observability", "status":"affected", "evidence":"Operations center must expose freshness, checkpoints, retries, DLQ, health, stale data and drift without leaking secrets."},
    {"area":"operations_rollback", "status":"affected", "evidence":"Each child runtime can be rolled back by capability disablement and worker drain; append-only accepted facts are not destructively removed."},
    {"area":"testing_conformance", "status":"affected", "evidence":"The acceptance gate requires deterministic connector/API tests, Docker conformance, failure recovery and separate provider live qualification."}
  ],
