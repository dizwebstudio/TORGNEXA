  "impacts": [
    {"area":"tenancy","status":"affected","evidence":"LM Studio accounts reuse the tenant/workspace-scoped AI provider account and governance boundary; no provider-owned tenant state is introduced."},
    {"area":"privacy_data_governance","status":"affected","evidence":"Credentials remain callback-scoped and only the governed prompt is sent to the configured local endpoint; raw prompts and responses are not persisted."},
    {"area":"api_compatibility","status":"affected","evidence":"The existing AI provider enum and settings surface are widened additively for lm-studio; no operation is removed."},
    {"area":"event_compatibility","status":"not_affected","evidence":"No event name or canonical envelope is added or changed."},
    {"area":"plugin_sdk_compatibility","status":"affected","evidence":"LM Studio is an SDK v1 connector with only ai.completion.generate; provider composition remains isolated in builtinruntime."},
    {"area":"database_migration","status":"affected","evidence":"Migration 000021 widens the generic provider CHECK and permits only the explicit local HTTP endpoint allowlist."},
    {"area":"security","status":"affected","evidence":"The host resolves and pins private/loopback addresses, disables proxies and redirects, bounds bodies, and never exposes secret bytes to connector code outside the callback."},
    {"area":"approvals_risk","status":"affected","evidence":"Existing AI governance, data-class and audit checks remain mandatory; the connector advertises no remote commerce writes."},
    {"area":"audit_lineage","status":"not_affected","evidence":"Existing AI account and analysis audit entries are reused without prompt, response or credential payloads."},
    {"area":"reconciliation_idempotency","status":"not_affected","evidence":"A completion has no remote commerce synchronization or durable provider-side write."},
    {"area":"webhooks_egress","status":"affected","evidence":"Only bounded outbound completion calls to approved local endpoints are admitted; no webhook ingress is added."},
    {"area":"slo_observability","status":"affected","evidence":"Manifest and host transport enforce concurrency, timeout and response-size bounds with normalized failures."},
    {"area":"operations_rollback","status":"affected","evidence":"Disabling the tenant account stops analysis immediately; the additive CHECK migration has no destructive data rollback."},
    {"area":"testing_conformance","status":"affected","evidence":"Connector, transport, API, generated-catalog and retained thirteen-check conformance evidence cover the admission boundary."}
  ],
  "provider": {"id":"lm-studio","route":"connector_sdk","manifest":"connectors/ai/lm-studio/manifest.json","connector_spec":"docs/connectors/lm-studio/spec.md","capability_audit":"docs/connectors/lm-studio/capability-audit.md","conformance_plan":"docs/connectors/lm-studio/conformance-plan.md"},
