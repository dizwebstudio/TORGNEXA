  "impacts": [
    {"area":"tenancy", "status":"affected", "evidence":"The authenticated route resolves the account and idempotency receipt inside the request workspace."},
    {"area":"privacy_data_governance", "status":"affected", "evidence":"Only provider batch ID, normalized status and observation time cross the transport boundary."},
    {"area":"api_compatibility", "status":"affected", "evidence":"A new additive approval-bound OpenAPI operation is exposed."},
    {"area":"event_compatibility", "status":"not_affected", "evidence":"The operation uses the existing operation receipt and creates no event schema."},
    {"area":"plugin_sdk_compatibility", "status":"affected", "evidence":"Generated Go, Python and TypeScript SDKs expose the additive batch cancellation method."},
    {"area":"database_migration", "status":"not_affected", "evidence":"Existing operation receipt storage is sufficient."},
    {"area":"security", "status":"affected", "evidence":"The fixed official HTTPS path, callback-scoped SecretProvider and numeric batch ID validation prevent credential or SSRF expansion."},
    {"area":"approvals_risk", "status":"affected", "evidence":"The state-changing operation requires write-sensitive capability and a matching approved resource digest."},
    {"area":"audit_lineage", "status":"affected", "evidence":"The operation is recorded through the existing approval and operation receipt paths."},
    {"area":"reconciliation_idempotency", "status":"affected", "evidence":"Tenant-scoped idempotency prevents replay; non-success and transport ambiguity fail closed."},
    {"area":"webhooks_egress", "status":"affected", "evidence":"Only the documented Dellin batch cancellation endpoint is admitted and no inbound callback is added."},
    {"area":"slo_observability", "status":"affected", "evidence":"The shared HTTP timeout and strict response validation cover successful and rejected provider responses."},
    {"area":"operations_rollback", "status":"affected", "evidence":"Removing the capability or runtime admission closes only Pre-Alert cancellation."},
    {"area":"testing_conformance", "status":"affected", "evidence":"Transport, connector and API fixtures cover endpoint selection, secret boundary, approval, idempotency and malformed responses."}
  ],
