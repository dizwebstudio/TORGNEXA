    {"area":"tenancy", "status":"affected", "evidence":"The authenticated route resolves the logistics account and receipt inside the request workspace."},
    {"area":"privacy_data_governance", "status":"affected", "evidence":"Only batch ID, ISO date, normalized status and observation time cross the adapter boundary."},
    {"area":"api_compatibility", "status":"affected", "evidence":"A new additive approval-bound OpenAPI operation and generated SDK method are added."},
    {"area":"event_compatibility", "status":"not_affected", "evidence":"The operation uses the existing operation receipt and adds no event schema."},
    {"area":"plugin_sdk_compatibility", "status":"affected", "evidence":"Generated Go, Python and TypeScript SDKs expose the additive operation."},
    {"area":"database_migration", "status":"not_affected", "evidence":"Existing operation receipt storage is sufficient; no schema change is required."},
    {"area":"security", "status":"affected", "evidence":"The route requires workspace scope, enabled capability, SecretProvider and matching approval."},
    {"area":"approvals_risk", "status":"affected", "evidence":"The write-sensitive batch update requires an approved matching resource digest."},
    {"area":"audit_lineage", "status":"affected", "evidence":"The state-changing operation is recorded through the existing operation and approval audit paths."},
    {"area":"reconciliation_idempotency", "status":"affected", "evidence":"Tenant-scoped idempotency receipt prevents replay and preserves pending ambiguity."},
    {"area":"webhooks_egress", "status":"affected", "evidence":"Only the documented Russian Post HTTPS path is admitted and no caller URL is accepted."},
    {"area":"slo_observability", "status":"affected", "evidence":"Transport bounds the request, validates empty/error-code responses and records observation time."},
    {"area":"operations_rollback", "status":"affected", "evidence":"Disabling the capability removes the UI/runtime admission without changing existing batch routes."},
    {"area":"testing_conformance", "status":"affected", "evidence":"Transport, connector, registry, API, contract and frontend checks cover success and rejection cases."}
