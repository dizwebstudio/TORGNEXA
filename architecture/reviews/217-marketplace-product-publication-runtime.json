  "impacts": [
    {"area":"tenancy", "status":"affected", "evidence":"Snapshots, idempotency keys, queue claims, API reads and evidence are scoped by authenticated organization and workspace."},
    {"area":"privacy_data_governance", "status":"affected", "evidence":"Snapshots accept released media references only; raw provider payloads, tokens and arbitrary URLs are rejected at the boundary."},
    {"area":"api_compatibility", "status":"affected", "evidence":"Additive preflight, enqueue, list, detail and retry operations are described in OpenAPI and generated SDKs."},
    {"area":"event_compatibility", "status":"affected", "evidence":"Operation transitions are retained as append-only publication evidence and do not introduce an incompatible event version."},
    {"area":"plugin_sdk_compatibility", "status":"affected", "evidence":"The typed ProductPublicationWriter port and products.write capability are additive to the connector SDK."},
    {"area":"database_migration", "status":"affected", "evidence":"Expand-only migration 44 adds snapshots, operations and append-only observations/drifts with catalog checksum and backup requirement."},
    {"area":"security", "status":"affected", "evidence":"Capability checks, approval binding, forced RLS, released-object media refs and provider-specific fixed transports enforce default deny."},
    {"area":"approvals_risk", "status":"affected", "evidence":"Live publication requires a matching approved marketplace.product.publish request; dry-run is explicitly non-mutating."},
    {"area":"audit_lineage", "status":"affected", "evidence":"The operation retains snapshot digest, quality receipt, approval reference, attempt and state transition lineage."},
    {"area":"reconciliation_idempotency", "status":"affected", "evidence":"Tenant/account idempotency, CAS transitions, normalized unknown outcomes and append-only drift types prevent blind duplicate writes."},
    {"area":"webhooks_egress", "status":"affected", "evidence":"Only the documented connector endpoints are used; no caller-controlled host, callback or raw response is admitted."},
    {"area":"slo_observability", "status":"affected", "evidence":"Bounded requests, worker batch claims, normalized error codes and asynchronous status states provide operational visibility."},
    {"area":"operations_rollback", "status":"affected", "evidence":"Capability disablement and worker drain stop new writes; expand migration has no destructive down path."},
    {"area":"testing_conformance", "status":"affected", "evidence":"Core, SDK, API, worker, transport/connector fixtures, generated SDK, migration and architecture gates cover the admitted boundary."}
  ],
