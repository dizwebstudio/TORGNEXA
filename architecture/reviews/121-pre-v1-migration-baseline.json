  "impacts": [
    {
      "area": "tenancy",
      "status": "affected",
      "evidence": "The baseline repackages the exact legacy tenant/RLS DDL statement order; fresh installs and verified rebaselined development databases converge on the same organization/workspace-scoped schema. No tenant selector or business row is rewritten."
    },
    {
      "area": "privacy_data_governance",
      "status": "affected",
      "evidence": "Privacy/secrets schema statements are preserved in the generated source ranges. Rebaseline evidence stores migration metadata only and no credentials, PII or business payloads."
    },
    {
      "area": "api_compatibility",
      "status": "not_affected",
      "evidence": "No OpenAPI route, request/response schema or generated SDK operation changes; the public surface remains OpenAPI 0.15.0 / 108 operations."
    },
    {
      "area": "event_compatibility",
      "status": "not_affected",
      "evidence": "No event catalog/topic/envelope/schema change. Outbox/Inbox DDL is statement-order-preserved from the immutable legacy source."
    },
    {
      "area": "plugin_sdk_compatibility",
      "status": "not_affected",
      "evidence": "Connector/plugin SDK contracts and provider manifests are unchanged."
    },
    {
      "area": "database_migration",
      "status": "affected",
      "evidence": "Fresh runtime migration inventory changes from 74 development files to 11 active baseline files. The original 74 files/catalog remain immutable evidence and exact legacy-head development databases require verified archival/stamping before using the compact catalog."
    },
    {
      "area": "security",
      "status": "affected",
      "evidence": "The one-time rebaseline requires DB-owner credentials plus an explicit acknowledgement, verifies all 74 version/name/checksum rows and final-schema sentinels, archives history before deletion/stamping in one transaction, and blocks partial/unknown history."
    },
    {
      "area": "approvals_risk",
      "status": "not_affected",
      "evidence": "Approval state machines and execution semantics are unchanged; only migration packaging/history lineage changes."
    },
    {
      "area": "audit_lineage",
      "status": "affected",
      "evidence": "All original migration_history rows are preserved in migration_history_legacy_pre_v1 before active baseline stamps are written, and migration_baseline_evidence records the verified source head/catalog digest."
    },
    {
      "area": "reconciliation_idempotency",
      "status": "not_affected",
      "evidence": "Reconciliation, Inbox and business idempotency runtime behavior is unchanged by the squash."
    },
    {
      "area": "webhooks_egress",
      "status": "not_affected",
      "evidence": "Webhook schema and outbound delivery behavior are unchanged; its historical migration tests now read immutable legacy evidence."
    },
    {
      "area": "slo_observability",
      "status": "affected",
      "evidence": "Fresh-install/bootstrap work is reduced to 11 migration files and baseline/rebaseline commands emit deterministic PASS/fail-closed evidence; application SLO definitions are unchanged."
    },
    {
      "area": "operations_rollback",
      "status": "affected",
      "evidence": "Before production v1 the source-tree squash can be reverted; a rebaselined development DB preserves all 74 old rows in the archive table. After v1 the compact baseline becomes immutable and all later changes are forward migrations."
    },
    {
      "area": "testing_conformance",
      "status": "affected",
      "evidence": "Migration policy tests validate the 11-entry active catalog, immutable 74-file archive checksums, deterministic baseline generation, active/legacy deploy metadata parity and fail-closed rebaseline guard. Domain migration tests are rebound to archived source evidence."
    }
  ],
  "provider": null,
  "follow_up_tasks": []
}
