  "impacts": [
    {
      "area": "tenancy",
      "status": "affected",
      "evidence": "OpenCart account configuration and mappings remain organization/workspace scoped; no tenant selector enters provider payloads."
    },
    {
      "area": "privacy_data_governance",
      "status": "affected",
      "evidence": "Order projection intentionally excludes OpenCart billing/shipping/customer identity fields; credentials remain behind SecretAccessor."
    },
    {
      "area": "api_compatibility",
      "status": "affected",
      "evidence": "No public TORGNEXA REST operation changes; Connector SDK changes are additive typed interfaces only."
    },
    {
      "area": "event_compatibility",
      "status": "affected",
      "evidence": "No canonical event schema changes; OpenCart webhooks enter existing inbox/sync boundaries after verification."
    },
    {
      "area": "plugin_sdk_compatibility",
      "status": "affected",
      "evidence": "Frozen Connector/Runtime roots are unchanged; commerce write, return and webhook interfaces are additive SDK-v1 capability surfaces."
    },
    {
      "area": "database_migration",
      "status": "affected",
      "evidence": "No database schema migration is required; Task-010 mappings and existing inbox/reconciliation persistence remain authoritative."
    },
    {
      "area": "security",
      "status": "affected",
      "evidence": "Store host/base path are constrained, query-string credentials are forbidden, webhook HMAC is constant-time verified and ambiguous writes fail closed."
    },
    {
      "area": "approvals_risk",
      "status": "affected",
      "evidence": "Host Task-017/082 policy remains mandatory before invoking commerce writes; provider capability does not bypass approvals/compliance."
    },
    {
      "area": "audit_lineage",
      "status": "affected",
      "evidence": "Write receipts and reconciliation outcomes preserve remote IDs for existing audit/lineage orchestration without storing raw credentials."
    },
    {
      "area": "reconciliation_idempotency",
      "status": "affected",
      "evidence": "SKU reconciliation protects creates; exact-state writes use read-before/read-after reconciliation; webhook replay uses signed-material identity."
    },
    {
      "area": "webhooks_egress",
      "status": "affected",
      "evidence": "OpenCart inbound webhooks require expected-topic binding and verified HMAC; provider outbound requests use only configured HTTPS store host."
    },
    {
      "area": "slo_observability",
      "status": "affected",
      "evidence": "Provider errors/rate-limit health are normalized through existing Connector SDK SLO surfaces."
    },
    {
      "area": "operations_rollback",
      "status": "affected",
      "evidence": "Connector admission is additive and can be disabled per account; no schema rollback is required."
    },
    {
      "area": "testing_conformance",
      "status": "affected",
      "evidence": "Deterministic unit tests and the Task-064 13-check provider report are required and recorded."
    }
  ],
