FROM node:22.16.0-alpine3.21@sha256:9f3ae04faa4d2188825803bf890792f33cc39033c9241fc6bb201149470436ca

WORKDIR /workspace
COPY sdk/typescript ./sdk/typescript
COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN cd frontend && npm ci --ignore-scripts --no-audit --no-fund
COPY frontend ./frontend
RUN cd frontend && npm run build

WORKDIR /workspace/frontend
USER node
EXPOSE 5173
CMD ["npm", "exec", "vite", "--", "preview", "--host", "0.0.0.0", "--port", "5173"]
